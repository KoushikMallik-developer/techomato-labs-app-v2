# Copy to `.env` (git-ignored) and edit. Vite only exposes vars prefixed VITE_
# to the browser, and only reads .env files at dev-server/build start — restart
# `npm run dev` after changing this file.
#
# Firebase console -> Project settings -> Your apps -> Web app -> SDK config.
# These are public identifiers, not secrets; firestore.rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
